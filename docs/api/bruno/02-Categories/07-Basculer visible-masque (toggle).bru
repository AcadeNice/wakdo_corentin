meta {
  name: Basculer visible/masque (toggle)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/admin/api/categories/{{created_category_id}}/toggle
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf}}
}

docs {
Bascule dans les DEUX sens (contrairement a DELETE qui ne masque que). Premiere bascule : actif (creation) -> masque.
}

tests {
  const body = res.getBody();
  test('200, is_active=false (bascule 1/2)', function () {
      expect(res.getStatus()).to.equal(200);
      expect(body.data.is_active).to.equal(false);
  });
}
