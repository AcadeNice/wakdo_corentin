meta {
  name: Lister les roles
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/admin/api/roles
}

docs {
Capture firstRoleId (premier role NON-ADMIN actif de la liste -- cf. commentaire de ROLE_LIST_LOOKUP_TEMPLATE) pour la requete suivante et pour la creation d'utilisateur (dossier Utilisateurs).
}

script:post-response {
  const body = res.getBody();
  if (body && body.data && body.data.length > 0) {
      var nonAdmin = body.data.find(function (r) { return r.code !== 'admin' && r.is_active; });
      var chosen = nonAdmin || body.data[0];
      bru.setEnvVar('firstRoleId', chosen.id);
  }
}

tests {
  test('200 OK', function () { expect(res.getStatus()).to.equal(200); });
}
