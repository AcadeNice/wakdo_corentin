meta {
  name: Se reconnecter (pour la demo de deconnexion)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/admin/api/auth/login
}

headers {
  Content-Type: application/json
}

body {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

docs {
Reprend une session admin fraiche (independante de RBAC ci-dessus) avant de la detruire.
}

script:post-response {
  const body = res.getBody();
  bru.setEnvVar('run', Date.now().toString(36));
  if (body && body.data && body.data.csrf_token) { bru.setEnvVar('csrf', body.data.csrf_token); }
}

tests {
  expect(res.getStatus()).to.equal(200);
}
